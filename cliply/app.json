{
  "expo": {
    "name": "Clypli",
    "slug": "cliply",
    "platforms": [
      "ios",
      "android"
    ],
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/illustrations/logos/stores_logo_1024.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "bundleIdentifier": "com.clypli.app",
      "supportsTablet": true,
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "uber",
          "uberdriver",
          "uber-partner",
          "lyftdriver",
          "lyft",
          "doordash",
          "dasher",
          "uber",
          "uberdriver",
          "uber-partner",
          "lyftdriver",
          "lyft",
          "doordash",
          "dasher"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.clypli.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/illustrations/logos/stores_logo_adaptive.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-asset",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "a51957cf-c0eb-4e59-8616-0b800b00ec5f"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a51957cf-c0eb-4e59-8616-0b800b00ec5f"
    }
  }
}
